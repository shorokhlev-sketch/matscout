# Copy to .env and fill. .env is gitignored.

# Materials Project: https://next-gen.materialsproject.org/api
# Keep this line even if empty: without it the web app does not start.
MP_API_KEY=

# OpenAI: web app agent, matscout CLI and live tests (the MCP server runs without it)
OPENAI_API_KEY=

# Optional contact address for the OpenAlex and Crossref polite pools.
# When set, their User-Agent carries mailto:<address>. Leave empty to send none.
MATSCOUT_CONTACT_EMAIL=

# Logging: "dev" pretty | "json" structured (default: dev)
MATSCOUT_LOG_FORMAT=dev

# Cache TTL in days for tool results (default: 30)
MATSCOUT_CACHE_TTL_DAYS=30
